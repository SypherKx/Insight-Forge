FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    # Also install backend-specific extras that were added later like python-multipart
    fastapi uvicorn[standard] python-multipart httpx pydantic-settings sqlalchemy aiosqlite structlog statsmodels

# Copy source code and backend code
COPY src/ /app/src/
COPY backend/ /app/backend/

# We'll also need the data generation script out here or simply keep it local,
# maybe we can just create the uploads directory
RUN mkdir -p /app/uploads

# Set env vars
ENV PYTHONPATH=/app
ENV HOST=0.0.0.0
ENV PORT=8000

# Expose backend port
EXPOSE 8000

# Run the application
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
